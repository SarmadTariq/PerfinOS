{
  "expo": {
    "name": "PerFin OS",
    "slug": "perfin-os",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PerFin OS uses your location to set the default place for new expenses.",
        "NSCameraUsageDescription": "PerFin OS uses the camera to attach receipt or payment images to expenses.",
        "NSPhotoLibraryUsageDescription": "PerFin OS uses your photo library to attach receipt or payment images to expenses."
      },
      "bundleIdentifier": "com.yashkanadhia.perfinos",
      "buildNumber": "1",
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0B0C0E"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.yashkanadhia.perfinos",
      "versionCode": 1,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "splash": {
        "image": "./assets/splash-icon-light.png",
        "resizeMode": "contain",
        "backgroundColor": "#FDFDFD"
      }
    },
    "plugins": [
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "PerFin OS uses your photo library to attach receipt or payment images to expenses.",
          "cameraPermission": "PerFin OS uses the camera to attach receipt or payment images to expenses.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "backgroundColor": "#FDFDFD",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0C0E"
          }
        }
      ]
    ]
  }
}
