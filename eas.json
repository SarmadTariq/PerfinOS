{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_PERFIN_APP_ENV": "local",
        "EXPO_PUBLIC_BILLING_PRODUCT_NAMESPACE": "perfin.local"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_PERFIN_APP_ENV": "preview",
        "EXPO_PUBLIC_BILLING_PRODUCT_NAMESPACE": "perfin.preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_PERFIN_APP_ENV": "production",
        "EXPO_PUBLIC_BILLING_PRODUCT_NAMESPACE": "perfin.production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
