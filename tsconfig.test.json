{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": ".test-build",
    "rootDir": ".",
    "noEmit": false,
    "ignoreDeprecations": "6.0",
    "types": [
      "node"
    ]
  },
  "include": [
    "tests/**/*.test.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "web-build",
    "workers",
    ".test-build"
  ]
}
