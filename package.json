{
  "name": "perfin-os",
  "version": "0.2.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "audit:prod": "npm audit --omit=dev",
    "test": "npm run test:planning",
    "test:planning": "vitest run tests/planning/planLifecycle.test.ts --fileParallelism=false",
    "test:firebase": "firebase emulators:exec --project demo-perfin-os --only firestore \"vitest run tests/firebase/planPersistence.test.ts --fileParallelism=false\"",
    "test:pf206": "npm run test:planning && npm run test:firebase",
    "test:pf207": "vitest run tests/planning/planEvidence.test.ts --fileParallelism=false"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/stack": "^7.8.9",
    "expo": "~54.0.34",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.11.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "~19.1.0",
    "firebase-tools": "^15.24.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "private": true
}
