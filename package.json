{
  "name": "perfin-os",
  "version": "0.2.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "build": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "audit:prod": "npm audit --omit=dev",
    "verify:release": "npm run typecheck:strict && npm run build && npm run audit:prod"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/stack": "^7.10.17",
    "expo": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-location": "~57.0.7",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "firebase": "^12.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "@babel/core": "7.29.7",
    "shell-quote": "1.10.0",
    "xcode": {
      "uuid": "11.1.1"
    },
    "ws@<8": "7.5.13"
  },
  "private": true
}
