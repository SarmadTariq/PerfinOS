rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    function isStandardEntityCollection(collectionId) {
      return collectionId in [
        'transactions',
        'categories',
        'budgets',
        'savingsGoals',
        'recurringExpenses',
        'reports'
      ];
    }

    function validProfile(userId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'name',
          'email',
          'phone',
          'createdAt'
        ])
        && request.resource.data.id == userId
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.createdAt is string;
    }

    function validFinancePreferences() {
      return request.resource.data.keys().hasOnly([
          'currency',
          'monthlyIncome',
          'monthlyBudget',
          'onboarded',
          'updatedAt'
        ])
        && request.resource.data.currency is string
        && request.resource.data.monthlyIncome is number
        && request.resource.data.monthlyIncome >= 0
        && request.resource.data.monthlyBudget is number
        && request.resource.data.monthlyBudget >= 0
        && request.resource.data.onboarded is bool
        && request.resource.data.updatedAt is string;
    }

    function validWorkspaceMeta() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'revision',
          'lastMutationId',
          'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.revision is int
        && request.resource.data.revision >= 0
        && request.resource.data.lastMutationId is string
        && request.resource.data.updatedAt is string;
    }

    function validMigrationState() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'status',
          'sourceSchemaVersion',
          'targetSchemaVersion',
          'attemptCount',
          'lastCompletedChunk',
          'sourceCounts',
          'targetCounts',
          'sourceChecksum',
          'targetChecksum',
          'fallbackAllowed',
          'conflicts',
          'failureCode',
          'startedAt',
          'updatedAt',
          'completedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.status in [
          'not_started',
          'preflight',
          'copying',
          'verifying',
          'completed',
          'failed',
          'legacy_retired'
        ]
        && request.resource.data.sourceSchemaVersion == 1
        && request.resource.data.targetSchemaVersion == 1
        && request.resource.data.attemptCount is int
        && request.resource.data.attemptCount >= 0
        && request.resource.data.lastCompletedChunk is int
        && request.resource.data.sourceCounts is map
        && request.resource.data.targetCounts is map
        && request.resource.data.fallbackAllowed is bool
        && request.resource.data.conflicts is list
        && request.resource.data.updatedAt is string;
    }

    function validAccountDeletionRequest(userId) {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'userId',
          'email',
          'status',
          'requestedAt',
          'updatedAt',
          'source',
          'receiptObjectKeys',
          'associatedCollections',
          'retryCount',
          'failureCode'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.userId == userId
        && request.resource.data.email is string
        && request.resource.data.status == 'requested'
        && request.resource.data.requestedAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.source == 'in_app'
        && request.resource.data.receiptObjectKeys is list
        && request.resource.data.receiptObjectKeys.size() <= 500
        && request.resource.data.associatedCollections is list
        && request.resource.data.associatedCollections.size() == 19
        && request.resource.data.retryCount == 0
        && request.resource.data.failureCode == null;
    }

    function migrationAllowsTargetCreateOrUpdate(userId) {
      let migrationPath = /databases/$(database)/documents/users/$(userId)/private/migration;
      return (
          !exists(migrationPath)
          && existsAfter(migrationPath)
          && getAfter(migrationPath).data.status == 'completed'
        )
        || (
          exists(migrationPath)
          && get(migrationPath).data.status in [
            'preflight',
            'copying'
          ]
          && getAfter(migrationPath).data.status == 'copying'
        );
    }

    function validCompletedWorkspaceMutation(userId) {
      let migrationPath = /databases/$(database)/documents/users/$(userId)/private/migration;
      let metaPath = /databases/$(database)/documents/users/$(userId)/private/workspaceMeta;
      return exists(migrationPath)
        && get(migrationPath).data.status == 'completed'
        && exists(metaPath)
        && getAfter(metaPath).data.revision
          == get(metaPath).data.revision + 1;
    }

    function validReceipt(userId, transactionId, receipt) {
      let objectPrefix = 'receipts/' + userId + '/' + transactionId + '/' + receipt.id + '.';
      return receipt is map
        && receipt.keys().hasOnly([
          'id',
          'objectKey',
          'fileName',
          'mimeType',
          'sizeBytes',
          'uploadedAt',
          'status'
        ])
        && receipt.id is string
        && receipt.id.matches('^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$')
        && receipt.fileName is string
        && receipt.mimeType in [
          'image/jpeg',
          'image/png',
          'image/heic',
          'image/heif'
        ]
        && receipt.sizeBytes is int
        && receipt.sizeBytes > 0
        && receipt.sizeBytes <= 5242880
        && receipt.uploadedAt is string
        && receipt.status == 'uploaded'
        && (
          (receipt.mimeType == 'image/jpeg' && receipt.objectKey == objectPrefix + 'jpg')
          || (receipt.mimeType == 'image/png' && receipt.objectKey == objectPrefix + 'png')
          || (receipt.mimeType == 'image/heic' && receipt.objectKey == objectPrefix + 'heic')
          || (receipt.mimeType == 'image/heif' && receipt.objectKey == objectPrefix + 'heif')
        );
    }

    function validReceiptAt(userId, transactionId, receipts, index) {
      return receipts.size() <= index
        || validReceipt(userId, transactionId, receipts[index]);
    }

    function validTransaction(userId, documentId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'userId',
          'type',
          'amount',
          'categoryId',
          'categoryName',
          'merchant',
          'date',
          'notes',
          'location',
          'paymentMethod',
          'isRecurring',
          'receipts',
          'updateCount',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id == documentId
        && request.resource.data.userId == userId
        && request.resource.data.type in ['income', 'expense']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.categoryId is string
        && request.resource.data.categoryName is string
        && request.resource.data.merchant is string
        && request.resource.data.date is string
        && request.resource.data.notes is string
        && request.resource.data.location is map
        && request.resource.data.paymentMethod is string
        && request.resource.data.isRecurring is bool
        && request.resource.data.receipts is list
        && request.resource.data.receipts.size() <= 5
        && validReceiptAt(userId, documentId, request.resource.data.receipts, 0)
        && validReceiptAt(userId, documentId, request.resource.data.receipts, 1)
        && validReceiptAt(userId, documentId, request.resource.data.receipts, 2)
        && validReceiptAt(userId, documentId, request.resource.data.receipts, 3)
        && validReceiptAt(userId, documentId, request.resource.data.receipts, 4)
        && request.resource.data.updateCount is int
        && request.resource.data.updateCount >= 0
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    function validCategory(documentId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'name',
          'type',
          'color',
          'icon',
          'monthlyBudget',
          'isDefault',
          'isArchived',
          'archivedAt'
        ])
        && request.resource.data.id == documentId
        && request.resource.data.name is string
        && request.resource.data.type in ['income', 'expense']
        && request.resource.data.color is string
        && request.resource.data.icon is string
        && request.resource.data.monthlyBudget is number
        && request.resource.data.monthlyBudget >= 0
        && request.resource.data.isDefault is bool;
    }

    function validBudget(userId, documentId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'userId',
          'month',
          'totalBudget',
          'categoryBudgets',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id == documentId
        && request.resource.data.userId == userId
        && request.resource.data.month is string
        && request.resource.data.totalBudget is number
        && request.resource.data.totalBudget >= 0
        && request.resource.data.categoryBudgets is map
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    function validSavingsGoal(userId, documentId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'userId',
          'name',
          'targetAmount',
          'currentAmount',
          'targetDate',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id == documentId
        && request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.targetAmount is number
        && request.resource.data.targetAmount > 0
        && request.resource.data.currentAmount is number
        && request.resource.data.currentAmount >= 0
        && request.resource.data.currentAmount < request.resource.data.targetAmount
        && request.resource.data.targetDate is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    function validRecurringExpense(userId, documentId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'userId',
          'merchant',
          'amount',
          'category',
          'frequency',
          'nextDate',
          'status'
        ])
        && request.resource.data.id == documentId
        && request.resource.data.userId == userId
        && request.resource.data.merchant is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.category is string
        && request.resource.data.frequency in [
          'weekly',
          'biweekly',
          'monthly',
          'quarterly',
          'annual'
        ]
        && request.resource.data.nextDate is string
        && request.resource.data.status in ['active', 'inactive'];
    }

    function validReport(userId, documentId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'userId',
          'month',
          'totalIncome',
          'totalExpense',
          'topCategory',
          'budgetStatus',
          'savingsProgress',
          'generatedAt',
          'periodStart',
          'periodEnd',
          'periodLabel',
          'source',
          'coverage'
        ])
        && request.resource.data.id == documentId
        && request.resource.data.userId == userId
        && request.resource.data.month is string
        && request.resource.data.totalIncome is number
        && request.resource.data.totalExpense is number
        && request.resource.data.topCategory is string
        && request.resource.data.budgetStatus is string
        && request.resource.data.savingsProgress is number
        && request.resource.data.generatedAt is string;
    }

    function hasValidPlanOwnership(userId, planId) {
      return request.resource.data.userId == userId
        && request.resource.data.id == planId;
    }

    function validPlanStatusTransition() {
      return request.resource.data.status == resource.data.status
        || (
          resource.data.status == 'draft'
          && request.resource.data.status in [
            'active',
            'archived'
          ]
        )
        || (
          resource.data.status == 'active'
          && request.resource.data.status in [
            'completed',
            'archived'
          ]
        )
        || (
          resource.data.status == 'completed'
          && request.resource.data.status == 'archived'
        );
    }

    function actionVersion(userId, planId, versionId) {
      return get(
        /databases/$(database)/documents/users/$(userId)/plans/$(planId)/versions/$(versionId)
      ).data;
    }

    function actionBinding(userId, planId, versionId, proposalId) {
      return actionVersion(
        userId,
        planId,
        versionId
      ).actionProposalApplications[proposalId];
    }

    function hasValidActionBinding(userId, planId) {
      let result = request.resource.data;
      let version = actionVersion(
        userId,
        planId,
        result.sourceVersionId
      );
      let binding =
        version.actionProposalApplications[result.proposalId];
      return version.actionProposalApplications is map
        && result.proposalId in version.actionProposalApplications
        && binding.keys().hasOnly([
          'schemaVersion',
          'type',
          'targetEntityId',
          'proposedAmount',
          'effectiveMonth'
        ])
        && binding.schemaVersion == 2
        && binding.effectiveMonth is string;
    }

    function actionProposalHasNotSucceeded(userId, planId) {
      let result = request.resource.data;
      let statePath = /databases/$(database)/documents/users/$(userId)/plans/$(planId)/actionState/current;
      return !exists(statePath)
        || get(statePath).data.sourceVersionId != result.sourceVersionId
        || !get(statePath).data.appliedProposalIds.hasAny([
          result.proposalId
        ]);
    }

    function validWorkspaceActionMutation(userId) {
      let result = request.resource.data;
      let metaPath = /databases/$(database)/documents/users/$(userId)/private/workspaceMeta;
      let beforeMeta = get(metaPath).data;
      let afterMeta = getAfter(metaPath).data;
      return beforeMeta.schemaVersion == 1
        && afterMeta.schemaVersion == 1
        && result.workspaceRevision == beforeMeta.revision
        && result.postWorkspaceRevision == afterMeta.revision
        && afterMeta.revision == beforeMeta.revision + 1
        && afterMeta.lastMutationId == 'plan:' + result.id;
    }

    function validTotalBudgetSuccess(userId) {
      let result = request.resource.data;
      let binding = actionBinding(
        userId,
        result.planId,
        result.sourceVersionId,
        result.proposalId
      );
      let budgetPath = /databases/$(database)/documents/users/$(userId)/budgets/$(result.financeDocumentId);
      let beforeBudget = get(budgetPath).data;
      let afterBudget = getAfter(budgetPath).data;
      return binding.type == 'budget_adjustment'
        && binding.targetEntityId == null
        && binding.proposedAmount == result.proposedValueMajor
        && binding.effectiveMonth == result.targetMonth
        && result.targetKind == 'budget'
        && result.targetId == result.financeDocumentId
        && result.targetMonth == beforeBudget.month
        && beforeBudget.userId == userId
        && beforeBudget.totalBudget == result.beforeValueMajor
        && afterBudget.totalBudget == result.proposedValueMajor
        && beforeBudget.totalBudget != afterBudget.totalBudget;
    }

    function validCategoryBudgetSuccess(userId) {
      let result = request.resource.data;
      let binding = actionBinding(
        userId,
        result.planId,
        result.sourceVersionId,
        result.proposalId
      );
      let budgetPath = /databases/$(database)/documents/users/$(userId)/budgets/$(result.financeDocumentId);
      let categoryPath = /databases/$(database)/documents/users/$(userId)/categories/$(result.targetId);
      let beforeBudget = get(budgetPath).data;
      let afterBudget = getAfter(budgetPath).data;
      let category = get(categoryPath).data;
      let beforeValue = beforeBudget.categoryBudgets.get(
        result.targetId,
        category.monthlyBudget
      );
      return binding.type == 'budget_adjustment'
        && binding.targetEntityId == result.targetId
        && binding.proposedAmount == result.proposedValueMajor
        && binding.effectiveMonth == result.targetMonth
        && result.targetKind == 'category_budget'
        && result.targetMonth == beforeBudget.month
        && beforeBudget.userId == userId
        && category.id == result.targetId
        && beforeValue == result.beforeValueMajor
        && afterBudget.categoryBudgets[result.targetId]
          == result.proposedValueMajor
        && beforeValue != afterBudget.categoryBudgets[result.targetId];
    }

    function validSavingsUpdateSuccess(userId) {
      let result = request.resource.data;
      let binding = actionBinding(
        userId,
        result.planId,
        result.sourceVersionId,
        result.proposalId
      );
      let goalPath = /databases/$(database)/documents/users/$(userId)/savingsGoals/$(result.financeDocumentId);
      let beforeGoal = get(goalPath).data;
      let afterGoal = getAfter(goalPath).data;
      return binding.type == 'savings_contribution'
        && (
          binding.targetEntityId == null
          || binding.targetEntityId == result.targetId
        )
        && binding.proposedAmount == result.changeValueMajor
        && result.targetKind == 'savings_goal'
        && result.targetId == result.financeDocumentId
        && result.targetMonth == null
        && beforeGoal.userId == userId
        && beforeGoal.currentAmount == result.beforeValueMajor
        && afterGoal.currentAmount == result.proposedValueMajor
        && beforeGoal.currentAmount != afterGoal.currentAmount;
    }

    function validSavingsCreateSuccess(userId) {
      let result = request.resource.data;
      let binding = actionBinding(
        userId,
        result.planId,
        result.sourceVersionId,
        result.proposalId
      );
      let goalPath = /databases/$(database)/documents/users/$(userId)/savingsGoals/$(result.financeDocumentId);
      return binding.type == 'savings_contribution'
        && binding.targetEntityId == null
        && binding.proposedAmount == result.changeValueMajor
        && result.targetKind == 'savings_goal'
        && result.targetId == result.financeDocumentId
        && result.targetMonth == null
        && result.beforeValueMajor == null
        && result.changeValueMajor == result.proposedValueMajor
        && !exists(goalPath)
        && existsAfter(goalPath)
        && getAfter(goalPath).data.userId == userId
        && getAfter(goalPath).data.currentAmount
          == result.proposedValueMajor;
    }

    function validSuccessfulActionWrite(userId) {
      let result = request.resource.data;
      return validWorkspaceActionMutation(userId)
        && (
          (
            result.beforeValueMajor != null
            && result.beforeValueMajor + result.changeValueMajor
              == result.proposedValueMajor
            && (
              (
                result.actionType == 'total_budget_update'
                && validTotalBudgetSuccess(userId)
              )
              || (
                result.actionType == 'category_budget_update'
                && validCategoryBudgetSuccess(userId)
              )
              || (
                result.actionType == 'savings_goal_update'
                && validSavingsUpdateSuccess(userId)
              )
            )
          )
          || (
            result.actionType == 'savings_goal_create'
            && validSavingsCreateSuccess(userId)
          )
        );
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /profile/main {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validProfile(userId)
          && (
            migrationAllowsTargetCreateOrUpdate(userId)
            || validCompletedWorkspaceMutation(userId)
          );
        allow delete: if false;
      }

      match /private/appData {
        allow read, write: if isOwner(userId);
      }

      match /private/preferences {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validFinancePreferences()
          && (
            migrationAllowsTargetCreateOrUpdate(userId)
            || validCompletedWorkspaceMutation(userId)
          );
        allow delete: if false;
      }

      match /private/entitlement {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /private/migration {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validMigrationState();
        allow delete: if false;
      }

      match /private/accountDeletion {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && validAccountDeletionRequest(userId);
        allow update: if isOwner(userId)
          && validAccountDeletionRequest(userId)
          && request.resource.data.requestedAt == resource.data.requestedAt;
        allow delete: if false;
      }

      match /private/workspaceMeta {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && validWorkspaceMeta()
          && request.resource.data.revision == 0;
        allow update: if isOwner(userId)
          && validWorkspaceMeta()
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }

      match /private/{documentId} {
        allow read, write: if false;
      }

      match /transactions/{documentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validTransaction(userId, documentId)
          && (
            migrationAllowsTargetCreateOrUpdate(userId)
            || validCompletedWorkspaceMutation(userId)
          );
        allow delete: if isOwner(userId)
          && validCompletedWorkspaceMutation(userId);
      }

      match /categories/{documentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validCategory(documentId)
          && (
            migrationAllowsTargetCreateOrUpdate(userId)
            || validCompletedWorkspaceMutation(userId)
          );
        allow delete: if isOwner(userId)
          && resource.data.isDefault == false
          && validCompletedWorkspaceMutation(userId);
      }

      match /budgets/{documentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validBudget(userId, documentId)
          && (
            migrationAllowsTargetCreateOrUpdate(userId)
            || validCompletedWorkspaceMutation(userId)
          );
        allow delete: if isOwner(userId)
          && validCompletedWorkspaceMutation(userId);
      }

      match /savingsGoals/{documentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validSavingsGoal(userId, documentId)
          && (
            migrationAllowsTargetCreateOrUpdate(userId)
            || validCompletedWorkspaceMutation(userId)
          );
        allow delete: if isOwner(userId)
          && validCompletedWorkspaceMutation(userId);
      }

      match /recurringExpenses/{documentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validRecurringExpense(userId, documentId)
          && (
            migrationAllowsTargetCreateOrUpdate(userId)
            || validCompletedWorkspaceMutation(userId)
          );
        allow delete: if isOwner(userId)
          && validCompletedWorkspaceMutation(userId);
      }

      match /reports/{documentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validReport(userId, documentId)
          && (
            migrationAllowsTargetCreateOrUpdate(userId)
            || validCompletedWorkspaceMutation(userId)
          );
        allow delete: if isOwner(userId)
          && validCompletedWorkspaceMutation(userId);
      }

      match /{collectionId}/{documentId} {
        allow read, write: if false;
      }

      match /plans/{planId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && hasValidPlanOwnership(userId, planId)
          && request.resource.data.status == 'draft'
          && request.resource.data.versionCount == 1
          && request.resource.data.replacedPlanId == null
          && request.resource.data.activatedAt == null
          && request.resource.data.completedAt == null
          && request.resource.data.archivedAt == null;

        allow update: if isOwner(userId)
          && resource.data.userId == userId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.id == resource.data.id
          && request.resource.data.id == planId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.startDate == resource.data.startDate
          && request.resource.data.endDate == resource.data.endDate
          && request.resource.data.currency == resource.data.currency
          && request.resource.data.horizon == resource.data.horizon
          && validPlanStatusTransition()
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'currentVersionId',
              'versionCount',
              'replacedPlanId',
              'updatedAt',
              'activatedAt',
              'completedAt',
              'archivedAt'
            ]);

        allow delete: if false;

        match /versions/{versionId} {
          allow read: if isOwner(userId);

          allow create: if isOwner(userId)
            && request.resource.data.userId == userId
            && request.resource.data.planId == planId
            && request.resource.data.id == versionId;

          allow update, delete: if false;
        }

        match /actionResults/{applicationId} {
          allow read: if isOwner(userId);

          allow create: if isOwner(userId)
            && request.resource.data.status in ['blocked', 'canceled']
            && request.resource.data.keys().hasOnly([
              'schemaVersion',
              'id',
              'userId',
              'planId',
              'sourceVersionId',
              'proposalId',
              'previewFingerprint',
              'selectionDigest',
              'actionType',
              'targetKind',
              'targetId',
              'financeDocumentId',
              'targetMonth',
              'workspaceRevision',
              'postWorkspaceRevision',
              'status',
              'failureCode',
              'retryable',
              'currency',
              'beforeValueMinor',
              'beforeValueMajor',
              'changeValueMinor',
              'changeValueMajor',
              'proposedValueMinor',
              'proposedValueMajor',
              'confirmedEvidenceRevision',
              'postEvidenceRevision',
              'previewRevision',
              'appliedAt'
            ])
            && request.resource.data.schemaVersion == 1
            && request.resource.data.id == applicationId
            && request.resource.data.userId == userId
            && request.resource.data.planId == planId
            && request.resource.data.sourceVersionId
              == get(
                /databases/$(database)/documents/users/$(userId)/plans/$(planId)
              ).data.currentVersionId
            && request.resource.data.proposalId is string
            && hasValidActionBinding(userId, planId)
            && actionProposalHasNotSucceeded(userId, planId)
            && request.resource.data.previewFingerprint is string
            && request.resource.data.selectionDigest is string
            && request.resource.data.retryable == false
            && (
              (
                request.resource.data.status == 'canceled'
                && request.resource.data.failureCode == null
              )
              || (
                request.resource.data.status == 'blocked'
                && request.resource.data.failureCode in [
                  'authentication_required',
                  'unsupported_action',
                  'confirmation_required',
                  'inactive_plan',
                  'historical_version',
                  'stale_evidence',
                  'currency_mismatch',
                  'target_missing',
                  'target_unauthorized',
                  'current_value_changed',
                  'amount_out_of_bounds',
                  'invalid_request',
                  'idempotency_conflict',
                  'write_failed'
                ]
              )
            )
            && request.resource.data.appliedAt == request.time;

          allow create: if isOwner(userId)
            && request.resource.data.status == 'success'
            && request.resource.data.keys().hasOnly([
              'schemaVersion',
              'id',
              'userId',
              'planId',
              'sourceVersionId',
              'proposalId',
              'previewFingerprint',
              'selectionDigest',
              'actionType',
              'targetKind',
              'targetId',
              'financeDocumentId',
              'targetMonth',
              'workspaceRevision',
              'postWorkspaceRevision',
              'status',
              'failureCode',
              'retryable',
              'currency',
              'beforeValueMinor',
              'beforeValueMajor',
              'changeValueMinor',
              'changeValueMajor',
              'proposedValueMinor',
              'proposedValueMajor',
              'confirmedEvidenceRevision',
              'postEvidenceRevision',
              'previewRevision',
              'appliedAt'
            ])
            && request.resource.data.schemaVersion == 1
            && request.resource.data.id == applicationId
            && request.resource.data.userId == userId
            && request.resource.data.planId == planId
            && request.resource.data.sourceVersionId is string
            && request.resource.data.sourceVersionId
              == get(
                /databases/$(database)/documents/users/$(userId)/plans/$(planId)
              ).data.currentVersionId
            && request.resource.data.proposalId is string
            && hasValidActionBinding(userId, planId)
            && request.resource.data.previewFingerprint is string
            && request.resource.data.selectionDigest is string
            && request.resource.data.financeDocumentId is string
            && request.resource.data.financeDocumentId.size() > 0
            && request.resource.data.workspaceRevision is int
            && request.resource.data.workspaceRevision >= 0
            && request.resource.data.postWorkspaceRevision is int
            && request.resource.data.postWorkspaceRevision
              == request.resource.data.workspaceRevision + 1
            && request.resource.data.actionType in [
              'total_budget_update',
              'category_budget_update',
              'savings_goal_create',
              'savings_goal_update'
            ]
            && request.resource.data.targetKind in [
              'budget',
              'category_budget',
              'savings_goal'
            ]
            && request.resource.data.status in ['success', 'blocked', 'canceled']
            && (
              (
                request.resource.data.status in ['success', 'canceled']
                && request.resource.data.failureCode == null
              )
              || (
                request.resource.data.status == 'blocked'
                && request.resource.data.failureCode in [
                  'authentication_required',
                  'unsupported_action',
                  'confirmation_required',
                  'inactive_plan',
                  'historical_version',
                  'stale_evidence',
                  'currency_mismatch',
                  'target_missing',
                  'target_unauthorized',
                  'current_value_changed',
                  'amount_out_of_bounds',
                  'invalid_request',
                  'idempotency_conflict',
                  'write_failed'
                ]
              )
            )
            && request.resource.data.retryable == false
            && request.resource.data.currency is string
            && (
              request.resource.data.beforeValueMinor == null
              || request.resource.data.beforeValueMinor is int
            )
            && (
              request.resource.data.beforeValueMajor == null
              || request.resource.data.beforeValueMajor is number
            )
            && request.resource.data.changeValueMinor is int
            && request.resource.data.changeValueMajor is number
            && request.resource.data.proposedValueMinor is int
            && request.resource.data.proposedValueMinor >= 0
            && request.resource.data.proposedValueMinor <= 1000000000000
            && request.resource.data.proposedValueMajor is number
            && request.resource.data.proposedValueMajor >= 0
            && request.resource.data.confirmedEvidenceRevision is string
            && request.resource.data.postEvidenceRevision is string
            && request.resource.data.previewRevision is string
            && request.resource.data.appliedAt == request.time
            && (
              (
                request.resource.data.actionType == 'total_budget_update'
                && request.resource.data.targetKind == 'budget'
              )
              || (
                request.resource.data.actionType == 'category_budget_update'
                && request.resource.data.targetKind == 'category_budget'
              )
              || (
                request.resource.data.actionType in [
                  'savings_goal_create',
                  'savings_goal_update'
                ]
                && request.resource.data.targetKind == 'savings_goal'
              )
            )
            && exists(
              /databases/$(database)/documents/users/$(userId)/plans/$(planId)/versions/$(request.resource.data.sourceVersionId)
            )
            && (
              request.resource.data.status != 'success'
              || (
                validSuccessfulActionWrite(userId)
                &&
                getAfter(
                  /databases/$(database)/documents/users/$(userId)/plans/$(planId)/actionState/current
                ).data.lastApplicationId == applicationId
                && getAfter(
                  /databases/$(database)/documents/users/$(userId)/plans/$(planId)/actionState/current
                ).data.acceptedEvidenceRevision
                  == request.resource.data.postEvidenceRevision
              )
            );

          allow update, delete: if false;
        }

        match /actionState/{stateId} {
          allow read: if isOwner(userId)
            && stateId == 'current';

          allow create, update: if isOwner(userId)
            && stateId == 'current'
            && request.resource.data.keys().hasOnly([
              'schemaVersion',
              'id',
              'userId',
              'planId',
              'sourceVersionId',
              'acceptedEvidenceRevision',
              'appliedProposalIds',
              'lastApplicationId',
              'updatedAt'
            ])
            && request.resource.data.schemaVersion == 1
            && request.resource.data.id == 'current'
            && request.resource.data.userId == userId
            && request.resource.data.planId == planId
            && request.resource.data.sourceVersionId
              == get(
                /databases/$(database)/documents/users/$(userId)/plans/$(planId)
              ).data.currentVersionId
            && request.resource.data.acceptedEvidenceRevision is string
            && request.resource.data.appliedProposalIds is list
            && request.resource.data.appliedProposalIds.size() > 0
            && request.resource.data.appliedProposalIds.size() <= 50
            && request.resource.data.appliedProposalIds.toSet().size()
              == request.resource.data.appliedProposalIds.size()
            && request.resource.data.lastApplicationId is string
            && request.resource.data.updatedAt == request.time
            && existsAfter(
              /databases/$(database)/documents/users/$(userId)/plans/$(planId)/actionResults/$(request.resource.data.lastApplicationId)
            )
            && request.resource.data.appliedProposalIds.hasAny([
              getAfter(
                /databases/$(database)/documents/users/$(userId)/plans/$(planId)/actionResults/$(request.resource.data.lastApplicationId)
              ).data.proposalId
            ])
            && getAfter(
              /databases/$(database)/documents/users/$(userId)/plans/$(planId)/actionResults/$(request.resource.data.lastApplicationId)
            ).data.status == 'success'
            && getAfter(
              /databases/$(database)/documents/users/$(userId)/plans/$(planId)/actionResults/$(request.resource.data.lastApplicationId)
            ).data.sourceVersionId == request.resource.data.sourceVersionId
            && getAfter(
              /databases/$(database)/documents/users/$(userId)/plans/$(planId)/actionResults/$(request.resource.data.lastApplicationId)
            ).data.postEvidenceRevision
              == request.resource.data.acceptedEvidenceRevision
            && (
              !exists(
                /databases/$(database)/documents/users/$(userId)/plans/$(planId)/actionState/current
              )
              || (
                (
                  resource.data.sourceVersionId
                    == request.resource.data.sourceVersionId
                  && request.resource.data.appliedProposalIds.hasAll(
                    resource.data.appliedProposalIds
                  )
                  && request.resource.data.appliedProposalIds.size()
                    == resource.data.appliedProposalIds.size() + 1
                )
                || (
                  resource.data.sourceVersionId
                    != request.resource.data.sourceVersionId
                  && request.resource.data.appliedProposalIds.size() == 1
                )
              )
            );

          allow delete: if false;
        }
      }

      match /planReservations/{dateKey} {
        allow read: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.dateKey == dateKey;

        allow delete: if isOwner(userId)
          && resource.data.userId == userId;
      }
    }
  }
}
